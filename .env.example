# Copy to .env and fill in. Never commit .env.
# Free keys: https://developer.trafiklab.se (see README).

# GTFS Regional Realtime – vehicle positions (required to see vehicles)
TRAFIKLAB_KEY=

# GTFS Regional Static – only used by build_trip_lookup.py, build_stations.py, build_geojson.py
GTFS_STATIC_KEY=

# Seconds the server reuses one answer from Trafiklab. 2 = live; use 60 while developing
# on a Bronze key so the monthly quota lasts.
VEHICLE_CACHE_SECONDS=60

# Transit region: a folder under regions/ (default sl = Stockholm)
# REGION=sl

# Your public domain, without https:// – the allowed CORS origin. Default localhost:8080.
# SITE_DOMAIN=example.com
# Extra allowed CORS origins, comma-separated.
# CORS_ORIGINS=https://www.example.com

# Proxies whose X-Real-IP header is trusted (default 127.0.0.1,::1 – nginx on the same machine)
# TRUSTED_PROXIES=127.0.0.1,::1

# PORT=8080
